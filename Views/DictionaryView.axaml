<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenccNetLibGui.ViewModels"
             xmlns:local="clr-namespace:OpenccNetLibGui.Constants"
             mc:Ignorable="d"
             x:Class="OpenccNetLibGui.Views.DictionaryView"
             x:Name="DictionaryViewRoot"
             x:DataType="vm:DictionaryGeneratorViewModel">
    <Border Margin="8" Padding="18"
            Background="{DynamicResource SettingsCardBackgroundBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="2" CornerRadius="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" Margin="0,0,18,0" x:DataType="vm:DictionaryGeneratorViewModel">
                <TextBlock Text="{Binding Contents.PageTitle}" FontSize="20" FontWeight="Bold" />
                <StackPanel Spacing="6" IsEnabled="{Binding !IsGenerating}">
                    <TextBlock Text="{Binding Contents.BaseDirectoryLabel}" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding BaseDictionaryDirectory, Mode=TwoWay}"
                                 PlaceholderText="dicts"
                                 ToolTip.Tip="{Binding Contents.BaseDirectoryToolTip}" />
                        <Button Grid.Column="1" MinWidth="92"
                                Command="{Binding BrowseBaseDirectoryCommand}"
                                ToolTip.Tip="{Binding Contents.BrowseBaseDirectoryToolTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon-font"
                                           Text="{x:Static local:Icons.FolderOpen}" />
                                <TextBlock Text="{Binding Contents.BrowseButton}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="6" IsEnabled="{Binding !IsGenerating}">
                    <TextBlock Text="{Binding Contents.OutputDirectoryLabel}" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding OutputDirectory, Mode=TwoWay}"
                                 ToolTip.Tip="{Binding Contents.OutputDirectoryToolTip}" />
                        <Button Grid.Column="1" MinWidth="92"
                                Command="{Binding BrowseOutputDirectoryCommand}"
                                ToolTip.Tip="{Binding Contents.BrowseOutputDirectoryToolTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon-font"
                                           Text="{x:Static local:Icons.FolderOpen}" />
                                <TextBlock Text="{Binding Contents.BrowseButton}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Contents.CustomSlotsLabel}" FontSize="16"
                               FontWeight="Bold" />
                    <Border Padding="12"
                            Background="{DynamicResource EditorSurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1" CornerRadius="6"
                            IsEnabled="{Binding !IsGenerating}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="190,130,*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding Contents.SlotColumn}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Contents.ModeColumn}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Contents.DictionaryFileColumn}"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CustomDictionaries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CustomDictionaryRowViewModel">
                                            <Grid ColumnDefinitions="190,130,*,Auto,Auto"
                                                  ColumnSpacing="8" Margin="0,0,0,8">
                                                <ComboBox ItemsSource="{Binding AvailableSlots}"
                                                          SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                                                          ToolTip.Tip="{Binding #DictionaryViewRoot.((vm:DictionaryGeneratorViewModel)DataContext).Contents.SlotToolTip, FallbackValue='Select the dictionary slot to customize.'}" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableModes}"
                                                          SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                                          ToolTip.Tip="{Binding #DictionaryViewRoot.((vm:DictionaryGeneratorViewModel)DataContext).Contents.ModeToolTip, FallbackValue='Append merges entries; Override replaces the selected slot.'}" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding DictionaryPath, Mode=TwoWay}"
                                                         PlaceholderText="{Binding #DictionaryViewRoot.((vm:DictionaryGeneratorViewModel)DataContext).Contents.DictionaryFilePlaceholder, FallbackValue='Dictionary file path'}"
                                                         ToolTip.Tip="{Binding #DictionaryViewRoot.((vm:DictionaryGeneratorViewModel)DataContext).Contents.DictionaryFileToolTip, FallbackValue='Path to a custom dictionary text file.'}" />
                                                <Button Grid.Column="3"
                                                        Command="{Binding BrowseCommand}"
                                                        ToolTip.Tip="{Binding #DictionaryViewRoot.((vm:DictionaryGeneratorViewModel)DataContext).Contents.BrowseDictionaryFileToolTip, FallbackValue='Select a custom dictionary text file.'}">
                                                    <StackPanel Orientation="Horizontal"
                                                            Spacing="6">
                                                        <TextBlock Classes="icon-font"
                                                                Text="{x:Static local:Icons.DictionaryAdd}" />
                                                        <TextBlock
                                                            Text="{Binding #DictionaryViewRoot.((vm:DictionaryGeneratorViewModel)DataContext).Contents.BrowseButton, FallbackValue=Browse}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="4"
                                                        Command="{Binding RemoveCommand}"
                                                        Classes="outline-button danger-outline-button"
                                                        ToolTip.Tip="{Binding #DictionaryViewRoot.((vm:DictionaryGeneratorViewModel)DataContext).Contents.RemoveRowToolTip, FallbackValue='Remove this custom dictionary row.'}">
                                                    <StackPanel Orientation="Horizontal"
                                                            Spacing="6">
                                                        <TextBlock Classes="icon-font"
                                                                Text="{x:Static local:Icons.RemoveFrom}" />
                                                        <TextBlock
                                                            Text="{Binding #DictionaryViewRoot.((vm:DictionaryGeneratorViewModel)DataContext).Contents.RemoveButton, FallbackValue=Remove}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button HorizontalAlignment="Left"
                                    Command="{Binding AddCustomDictionaryCommand}"
                                    ToolTip.Tip="{Binding Contents.AddRowToolTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="icon-font"
                                               Text="{x:Static local:Icons.AddTo}" />
                                    <TextBlock Text="{Binding Contents.AddCustomDictionaryButton}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10"
                            IsEnabled="{Binding !IsGenerating}">
                    <Button Command="{Binding GenerateZstdCommand}"
                            ToolTip.Tip="{Binding Contents.GenerateZstdToolTip}"
                            MinWidth="130">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon-font"
                                       Text="{x:Static local:Icons.ReadingMode}" />
                            <TextBlock Text="{Binding Contents.GenerateZstdButton}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GenerateCborCommand}"
                            ToolTip.Tip="{Binding Contents.GenerateCborToolTip}"
                            MinWidth="130">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon-font"
                                       Text="{x:Static local:Icons.ReadingMode}" />
                            <TextBlock Text="{Binding Contents.GenerateCborButton}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GenerateJsonCommand}"
                            ToolTip.Tip="{Binding Contents.GenerateJsonToolTip}"
                            MinWidth="130">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon-font"
                                       Text="{x:Static local:Icons.ReadingMode}" />
                            <TextBlock Text="{Binding Contents.GenerateJsonButton}" />
                        </StackPanel>
                    </Button>
                    <CheckBox Content="{Binding Contents.ReadableUnicodeJsonLabel}"
                              IsChecked="{Binding ReadableUnicodeJson, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{Binding Contents.ReadableUnicodeJsonToolTip}" />
                </StackPanel>
                <Border Padding="12"
                        Background="{DynamicResource EditorSurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsVisible="{Binding IsGenerating}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressBar Width="180"
                                     IsIndeterminate="True" />
                        <TextBlock Text="{Binding GenerationStatus}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Padding="12"
                        Background="{DynamicResource EditorSurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsVisible="{Binding !IsGenerating}">
                    <TextBlock Text="{Binding GenerationStatus}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
